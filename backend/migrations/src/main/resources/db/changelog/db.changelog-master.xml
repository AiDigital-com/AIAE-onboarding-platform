<?xml version="1.0" encoding="UTF-8"?>
<!--
    Liquibase records applied changesets by (id, author, filename), where
    filename is the CLASSPATH path db/changelog/... — see
    spring.liquibase.change-log in application.yml. Renaming the
    db/changelog/ DIRECTORY changes that path and will re-run all 14
    changesets against a populated schema. The Maven module name is NOT
    part of this path and may change freely. Do not "tidy" db/ to match
    the module name.

    This FILE may be renamed safely: it declares zero changesets (a single
    <include> below), and Liquibase only records the filename of the file
    where a changeset is DECLARED — that is 1.0.0/db.version-master.xml,
    which does not move.
-->
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

	<include file="1.0.0/db.version-master.xml" relativeToChangelogFile="true"/>

	<!-- New (P6), not versioned history — cache-invalidation outbox table backing
	     backend/cache-management. See docs/aiae-migration-plan.md §2.7. -->
	<include file="changes/0003-cache-invalidation.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
