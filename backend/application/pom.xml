<?xml version="1.0" encoding="UTF-8"?>
<!--
  Application module — the ONLY module with @SpringBootApplication and the
  ONLY one activating spring-boot-maven-plugin (repackage). <start-class>
  points repackage at the main class. Pulls in service (+ domain transitively)
  and db (Liquibase changelogs in fat jar).
  Generated OpenAPI sources in target/generated-sources/openapi.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.aidigital.aionboarding</groupId>
		<artifactId>app-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>application</artifactId>
	<name>AIAE Onboarding Platform — application</name>

	<properties>
		<!-- Must match FQN of @SpringBootApplication class. Consumed by
			 parent pluginManagement's <mainClass>${start-class}. -->
		<start-class>${project.groupId}.Application</start-class>
	</properties>

	<!-- commons-csv was removed: zero usage anywhere in backend/ (verified by
		 grep for CSVFormat/CSVPrinter/commons.csv) — the "CSV export endpoints"
		 comment described a feature that was never implemented. Every other
		 spring-boot-starter-* below stays: each is a POM-only aggregator, always
		 "unused declared" to a bytecode-reference analyzer once the classes this
		 module references directly (below) are declared, but each also supplies
		 real autoconfiguration/classpath-driven behaviour no direct import can
		 stand in for (embedded Tomcat/MVC, the security filter chain, AOP
		 proxying, actuator endpoints, bean validation). `migrations` and
		 `observability` likewise stay declared with no direct class reference:
		 `migrations` puts Liquibase changelog *resources* on the fat-jar
		 classpath, and `observability`'s two classes are consumed only inside
		 `external-services`' PooledRestClientFactory, never imported here.
		 logstash-logback-encoder, springdoc-openapi-starter-webmvc-ui,
		 hibernate-jcache and ehcache are picked up by class-name string
		 (logback.xml) or classpath presence (Hibernate's
		 hibernate.javax.cache.uri, SpringDoc's classpath scan), never by a
		 direct Java import either. All documented in
		 backend/DEPENDENCY-ANALYSIS.md. -->
	<dependencies>
		<!-- REQUIRED edges (drop either → broken):
			   application → service (transitively brings domain)
			   application → db      (Liquibase changelogs MUST be in fat jar) -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>service</artifactId>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>migrations</artifactId>
		</dependency>

		<!-- Reusable outbound metrics: ExternalClientMetricsInterceptor,
			 ExternalCallTimer (see .claude/rules/00-backend-hard-rules.md). -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>observability</artifactId>
		</dependency>

		<!-- external-services is NOT declared directly here on purpose:
			 structure-lint forbids an application -> external-services pom.xml
			 edge ("route through service/"). YoutubeController/YoutubeApiMapper
			 use external-services' YoutubeClient/model types directly in Java,
			 reached transitively through the existing service -> external-services
			 edge, so maven-dependency-plugin:analyze-only flags it "used
			 undeclared" — ignored, not declared; see
			 backend/DEPENDENCY-ANALYSIS.md. -->

		<!-- Web + security + AOP + actuator -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- OpenAPI: SpringDoc UI + generator runtime types -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<!-- Observability -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
		</dependency>
		<dependency>
			<groupId>org.zalando</groupId>
			<artifactId>logbook-spring-boot-starter</artifactId>
		</dependency>

		<!-- commons-csv removed P15 (2026-08-14): zero usage anywhere in
			 backend/ — see backend/DEPENDENCY-ANALYSIS.md. -->

		<!-- Lombok + MapStruct (for ServiceRecord ↔ ApiDto mappers) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
		</dependency>

		<!-- Runtime DB driver -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Hibernate L2/query cache (dictionary entities only, see
			 domain/.../dictionary/entities/*.java @Cache annotations and
			 application.yml spring.jpa.properties.hibernate.cache.*). -->
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-jcache</artifactId>
			<version>${hibernate.version}</version>
		</dependency>
		<dependency>
			<groupId>org.ehcache</groupId>
			<artifactId>ehcache</artifactId>
			<classifier>jakarta</classifier>
		</dependency>
		<dependency>
			<groupId>javax.cache</groupId>
			<artifactId>cache-api</artifactId>
		</dependency>

		<!-- Bridges the shared javax.cache manager into Spring's cache abstraction
			 (org.springframework.cache.jcache.JCacheCacheManager) for the cache-management
			 module's CacheService/CacheUpdaterService. No @EnableCaching — see
			 com.aidigital.aionboarding.config.CacheManagerConfig. -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context-support</artifactId>
		</dependency>

		<!-- Test scope -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- H2 — used by application-test.yml so ApplicationSmokeTest boots
			 without Postgres. LiquibaseChangelogSmokeTest uses real Postgres
			 via Testcontainers and ignores H2. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.instancio</groupId>
			<artifactId>instancio-junit</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Direct types used by controllers/config/security/mappers/generated
			 OpenAPI sources, declared explicitly per
			 maven-dependency-plugin:analyze-only. Versions come from the Spring
			 Boot BOM (spring-boot-starter-parent). -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-beans</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-tx</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-orm</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-core</artifactId>
		</dependency>
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.zalando</groupId>
			<artifactId>logbook-api</artifactId>
			<version>${logbook.version}</version>
		</dependency>
		<dependency>
			<groupId>org.zalando</groupId>
			<artifactId>logbook-core</artifactId>
			<version>${logbook.version}</version>
		</dependency>
		<dependency>
			<groupId>org.zalando</groupId>
			<artifactId>logbook-json</artifactId>
			<version>${logbook.version}</version>
		</dependency>
		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-annotations-jakarta</artifactId>
			<version>2.2.27</version>
		</dependency>
		<!-- Tomcat 10.1's embed-core vendors the jakarta.servlet API classes
			 directly (no separate jakarta.servlet-api jar is resolved on this
			 classpath) — HttpServletRequest/HttpServletResponse used throughout
			 the filter chain and GlobalExceptionHandler resolve from here. -->
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-core</artifactId>
		</dependency>

		<!-- Kept at COMPILE scope, not test — verified empirically. The
			 analyzer's "non-test scoped test only" signal was wrong for all
			 four: scoping them to test broke main compilation (javac needs
			 domain/cache-management/jakarta.persistence-api/spring-data-jpa
			 present on the compile classpath to resolve supertypes and
			 Spring config classes that application's main sources never name
			 directly by import). Documented as ignoredNonTestScopedDependencies
			 in the parent pom; see backend/DEPENDENCY-ANALYSIS.md. -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>domain</artifactId>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>cache-management</artifactId>
		</dependency>
		<dependency>
			<groupId>jakarta.persistence</groupId>
			<artifactId>jakarta.persistence-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-commons</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-core</artifactId>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-params</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.hamcrest</groupId>
			<artifactId>hamcrest</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-test-autoconfigure</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.instancio</groupId>
			<artifactId>instancio-core</artifactId>
			<version>${instancio.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Repackage into executable jar. Configuration (mainClass,
				 excludes) inherited from parent pluginManagement. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Generate Spring interfaces + DTOs from openapi.yaml.
				 Configuration inherited from parent pluginManagement;
				 only this module has an openapi.yaml to generate from. -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
			</plugin>

		</plugins>
	</build>
</project>
