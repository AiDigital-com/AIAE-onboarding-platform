<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.aidigital.aionboarding</groupId>
        <artifactId>app-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>service</artifactId>
    <name>AIAE Onboarding Platform — service</name>

    <!-- Business orchestration. Depends on domain; add external-services only
         when real external integrations exist. NEVER depend on application.
         Hosts AppException family under service/common/error/. @LogUsage
         lives in the `event-logging-to-db-feature` module — declared here
         so *ServiceImpl classes can annotate methods; application/ picks
         the module up transitively through this edge. To fully remove
         usage logging: drop this dep, drop
         `<module>event-logging-to-db-feature</module>` from the parent,
         and delete the `<include file="db/changelog/changes/0001-usage-events.xml"/>`
         line from db.changelog-master.xml. -->
    <!-- spring-boot-starter is a POM-only aggregator, and
         event-logging-to-db-feature is carried for the *ServiceImpl auto-
         instrumentation edge (UsageLoggingAspect matches by package/class-name
         pointcut, not by import — see docs/aiae-migration-plan.md §"Correction:
         the usage-telemetry module is live, not dormant"). Both are always
         "unused declared" to a bytecode-reference analyzer; documented and
         ignored, see backend/DEPENDENCY-ANALYSIS.md. -->
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>event-logging-to-db-feature</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- jakarta.validation: needed for ValidationMessage annotations. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- HTML sanitization for persisted lesson content. -->
        <dependency>
            <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
            <artifactId>owasp-java-html-sanitizer</artifactId>
        </dependency>

        <!-- Test scope — mockito + junit + assertj + spring-test bundled. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Instancio: generates entity/model/DTO fixtures per .claude/rules/20-tests.md. -->
        <dependency>
            <groupId>org.instancio</groupId>
            <artifactId>instancio-junit</artifactId>
            <scope>test</scope>
        </dependency>
            <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>external-services</artifactId>
        </dependency>
        <!-- Distributed cache invalidation mechanism (see
             .claude/agent_docs/distributed_cache.md). This module owns the JPA outbox
             implementation (JpaCacheInvalidationEventService) and the application-owned
             registry (ApplicationCacheNamesByClassRegistry). -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>cache-management</artifactId>
        </dependency>

        <!-- Direct types used across the *ServiceImpl classes, declared
             explicitly per maven-dependency-plugin:analyze-only. Versions come
             from the Spring Boot BOM (spring-boot-starter-parent). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-orm</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.instancio</groupId>
            <artifactId>instancio-core</artifactId>
            <version>${instancio.version}</version>
            <scope>test</scope>
        </dependency>
</dependencies>
</project>
