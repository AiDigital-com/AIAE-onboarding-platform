<?xml version="1.0" encoding="UTF-8"?>
<!--
  Self-contained event-logging-to-db-feature module. Owns the full usage-
  logging Java surface: @LogUsage, UsageAttributes, UsageEvent, UsageLogger,
  the aspect, configs, JPA entity + repository. `service` depends on this
  module so *ServiceImpl classes can carry @LogUsage; `application` picks
  it up transitively through the service edge.

  Database migrations live in the `migrations` module — NOT here. Migrations are
  intentionally single-sourced: `backend/migrations/src/main/resources/db/changelog/`
  is the ONE place Liquibase changelogs sit, regardless of which feature
  module owns the corresponding @Entity. Splitting changelogs across modules
  hides the table-creation contract from the migration owner and makes
  cross-module Liquibase classpath includes a long-term footgun.

  Removal flow (in order):
    - Lightweight kill (no recompile): set `app.usage-logging.enabled=false`
      → aspect + PostgresUsageLogger drop out, NoOpUsageLogger binds, table
      stays.
    - Full removal: drop <module>event-logging-to-db-feature</module> from
      backend/pom.xml, drop the dependency line from service/pom.xml, delete
      every @LogUsage import + usage from *ServiceImpl, and remove the
      <include file="db/changelog/changes/0001-usage-events.xml"/> line from
      db/src/main/resources/db/changelog/db.changelog-master.xml.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.aidigital.aionboarding</groupId>
		<artifactId>app-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>event-logging-to-db-feature</artifactId>
	<name>AIAE Onboarding Platform — event-logging-to-db-feature</name>

	<!-- Self-contained, removable feature. Must NOT depend on any other internal
		 module (domain/service/application). ID semantics live in this module.

		 The five spring-boot-starter-* aggregators below are POM-only — no
		 classes of their own — so maven-dependency-plugin:analyze-only always
		 reports them "unused declared" once the actual JPA/AOP/web/security
		 types this module references directly are declared explicitly (below).
		 They stay: they supply the autoconfiguration and Spring AOP proxying
		 infrastructure this module's own Spring-context tests
		 (UsageLoggingAspectTest, UsageLoggingConfigTest) boot against, none of
		 which is representable as a direct class reference. See
		 backend/DEPENDENCY-ANALYSIS.md. -->
	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>

		<!-- JPA entity + repository -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- @Aspect + @Around -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>

		<!-- Usage-executor queue/rejection gauges (ExecutorServiceMetrics) -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-core</artifactId>
		</dependency>

		<!-- HttpServletRequest + RequestContextHolder for client_ip/user_agent -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- SecurityContextHolder, Authentication, Jwt (Bearer JWT path) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!-- Direct types used by UsageLoggingAspect / UsageEventEntity /
			 UsageEventPersistenceService / UsageLoggingConfig / RoutingUsageEventSink,
			 declared explicitly per maven-dependency-plugin:analyze-only. Versions
			 come from the Spring Boot BOM (spring-boot-starter-parent), same as the
			 starters above. -->
		<dependency>
			<groupId>jakarta.persistence</groupId>
			<artifactId>jakarta.persistence-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-tx</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-beans</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-core</artifactId>
		</dependency>

		<!-- Test-only: JwtAuthenticationConverter is exercised only from
			 UsageLoggingAspectTest, never from main sources. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-resource-server</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Test: JUnit 5 + Mockito + AssertJ + Spring test context. Proves the
			 aspect auto-intercepts every public *ServiceImpl method. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
