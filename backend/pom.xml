<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<groupId>com.aidigital.aionboarding</groupId>
	<artifactId>app-parent</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>AIAE Onboarding Platform — parent</name>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.4.0</version>
		<relativePath/>
	</parent>

	<modules>
		<module>domain</module>
		<module>migrations</module>
		<module>event-logging-to-db-feature</module>
		<module>service</module>
		<module>application</module>
		<module>external-services</module>
		<module>observability</module>
		<module>cache-management</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<lombok.version>1.18.40</lombok.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<openapi-generator.version>7.10.0</openapi-generator.version>

		<springdoc.version>2.8.3</springdoc.version>
		<logstash-logback-encoder.version>8.0</logstash-logback-encoder.version>
		<logbook.version>3.10.0</logbook.version>
		<commons-csv.version>1.12.0</commons-csv.version>
		<testcontainers.version>1.20.4</testcontainers.version>
		<instancio.version>5.5.1</instancio.version>
		<owasp-html-sanitizer.version>20240325.1</owasp-html-sanitizer.version>

		<jacoco.version>0.8.12</jacoco.version>
		<checkstyle.version>10.21.0</checkstyle.version>
		<maven-dependency-plugin.version>3.7.1</maven-dependency-plugin.version>

		<git-commit-id.skip>false</git-commit-id.skip>

		<!-- Strict coverage floor, D-C (docs/aiae-migration-plan.md §6.1). This is the
			 pom default, so a bare `mvn verify` is always strict — modules that cannot
			 meet it yet override one or both properties in their own pom, pinned at
			 their measured value with a dated comment (P9, 2026-08-11). -->
		<jacoco.line.coverage>0.80</jacoco.line.coverage>
		<jacoco.branch.coverage>0.70</jacoco.branch.coverage>
	</properties>

	<dependencyManagement>
		<dependencies>

			<!-- Internal modules. -->
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>domain</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>migrations</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>service</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>event-logging-to-db-feature</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Lombok / MapStruct -->
			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>${lombok.version}</version>
				<scope>provided</scope>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct-processor</artifactId>
				<version>${mapstruct.version}</version>
				<scope>provided</scope>
			</dependency>

			<!-- Observability -->
			<dependency>
				<groupId>net.logstash.logback</groupId>
				<artifactId>logstash-logback-encoder</artifactId>
				<version>${logstash-logback-encoder.version}</version>
			</dependency>
			<dependency>
				<groupId>org.zalando</groupId>
				<artifactId>logbook-spring-boot-starter</artifactId>
				<version>${logbook.version}</version>
			</dependency>

			<!-- OpenAPI / SpringDoc -->
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>

			<!-- CSV (export endpoints) -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-csv</artifactId>
				<version>${commons-csv.version}</version>
			</dependency>

			<!-- Testcontainers (integration tests with real Postgres) -->
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Instancio (test-scope fixture generation for entities/models/DTOs, .claude/rules/20-tests.md) -->
			<dependency>
				<groupId>org.instancio</groupId>
				<artifactId>instancio-junit</artifactId>
				<version>${instancio.version}</version>
				<scope>test</scope>
			</dependency>

			<!-- HTML sanitization for persisted lesson content -->
			<dependency>
				<groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
				<artifactId>owasp-java-html-sanitizer</artifactId>
				<version>${owasp-html-sanitizer.version}</version>
			</dependency>

			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>external-services</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>observability</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>cache-management</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>

				<!-- Spring Boot repackage: only `application` activates it
					 (sets <start-class>); other modules never try to repackage. -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<configuration>
						<mainClass>${start-class}</mainClass>
						<excludes>
							<exclude>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</exclude>
						</excludes>
					</configuration>
					<executions>
						<execution>
							<id>repackage</id>
							<goals>
								<goal>repackage</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<release>${maven.compiler.release}</release>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
							<path>
								<groupId>org.mapstruct</groupId>
								<artifactId>mapstruct-processor</artifactId>
								<version>${mapstruct.version}</version>
							</path>
							<path>
								<groupId>org.springframework.boot</groupId>
								<artifactId>spring-boot-configuration-processor</artifactId>
							</path>
							<path>
								<groupId>org.hibernate.orm</groupId>
								<artifactId>hibernate-jpamodelgen</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-checkstyle-plugin</artifactId>
					<version>3.6.0</version>
					<configuration>
						<!-- ${maven.multiModuleProjectDirectory} resolves to backend/. -->
						<configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
						<suppressionsLocation>${maven.multiModuleProjectDirectory}/config/checkstyle-suppressions.xml
						</suppressionsLocation>
						<consoleOutput>true</consoleOutput>
						<failOnViolation>true</failOnViolation>
						<violationSeverity>warning</violationSeverity>
						<includeTestSourceDirectory>false</includeTestSourceDirectory>
						<skip>true</skip>
					</configuration>
					<dependencies>
						<dependency>
							<groupId>com.puppycrawl.tools</groupId>
							<artifactId>checkstyle</artifactId>
							<version>${checkstyle.version}</version>
						</dependency>
					</dependencies>
					<executions>
						<execution>
							<id>checkstyle-check</id>
							<phase>verify</phase>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
					<executions>
						<execution>
							<id>jacoco-prepare</id>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
						</execution>
						<execution>
							<id>jacoco-report</id>
							<phase>test</phase>
							<goals>
								<goal>report</goal>
							</goals>
							<configuration>
								<excludes>
									<!-- Only generated OpenAPI server code. Every hand-written exclude
										 (entities/, *Entity.class, models/, *Exception.class,
										 repositories/, config/, *_.class) was removed by P9 — see
										 docs/aiae-migration-plan.md §6.1 D-C — because it hid
										 hand-written code from both this report and the check
										 below. Kept in sync with the jacoco-check rule's excludes,
										 so the report humans read matches what the gate enforces. -->
									<exclude>**/api/v1/model/**</exclude>
									<exclude>**/api/v1/invoker/**</exclude>
									<exclude>**/api/v1/*Api.class</exclude>
								</excludes>
							</configuration>
						</execution>
						<execution>
							<id>jacoco-check</id>
							<phase>verify</phase>
							<goals>
								<goal>check</goal>
							</goals>
							<configuration>
								<excludes>
									<exclude>**/api/v1/model/**</exclude>
									<exclude>**/api/v1/invoker/**</exclude>
									<exclude>**/api/v1/*Api.class</exclude>
								</excludes>
								<rules>
									<rule>
										<element>BUNDLE</element>
										<limits>
											<limit>
												<counter>LINE</counter>
												<value>COVEREDRATIO</value>
												<minimum>${jacoco.line.coverage}</minimum>
											</limit>
											<limit>
												<counter>BRANCH</counter>
												<value>COVEREDRATIO</value>
												<minimum>${jacoco.branch.coverage}</minimum>
											</limit>
										</limits>
									</rule>
								</rules>
							</configuration>
						</execution>
					</executions>
				</plugin>

				<!-- P15 step 1a (docs/aiae-migration-plan.md). analyze-only bound to
					 verify, failOnWarning=true, ignoreNonCompile=true — every module's
					 direct compile-time dependency graph must be declared explicitly.
					 The ignore list below is exhaustive and documented coordinate by
					 coordinate in backend/DEPENDENCY-ANALYSIS.md; every entry is a
					 POM-only aggregator or a resource/classpath-driven edge that a
					 bytecode-reference analyzer structurally cannot see as "used". -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-dependency-plugin</artifactId>
					<version>${maven-dependency-plugin.version}</version>
					<executions>
						<execution>
							<id>analyze-declared-dependencies</id>
							<phase>verify</phase>
							<goals>
								<goal>analyze-only</goal>
							</goals>
							<configuration>
								<failOnWarning>true</failOnWarning>
								<ignoreNonCompile>true</ignoreNonCompile>
								<ignoredUnusedDeclaredDependencies>
									<!-- Lombok is consumed only by javac's annotation processor;
										 its generated bytecode has no Lombok reference. -->
									<ignoredUnusedDeclaredDependency>org.projectlombok:lombok</ignoredUnusedDeclaredDependency>
									<!-- service carries this so *ServiceImpl classes can opt into
										 @LogUsage without a pom.xml change; application receives the
										 live aspect transitively. See backend/DEPENDENCY-ANALYSIS.md. -->
									<ignoredUnusedDeclaredDependency>${project.groupId}:event-logging-to-db-feature</ignoredUnusedDeclaredDependency>
									<!-- migrations puts Liquibase changelog resources on the
										 classpath; it owns no Java class today that would reference
										 liquibase-core. -->
									<ignoredUnusedDeclaredDependency>org.liquibase:liquibase-core</ignoredUnusedDeclaredDependency>
									<!-- external-services: required on the classpath for IRSA
										 web-identity credential resolution; no Java class
										 references it. -->
									<ignoredUnusedDeclaredDependency>software.amazon.awssdk:sts</ignoredUnusedDeclaredDependency>
									<!-- migrations/observability: resource-only or transitively-
										 consumed-elsewhere internal modules with no direct class
										 import from application. -->
									<ignoredUnusedDeclaredDependency>${project.groupId}:migrations</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>${project.groupId}:observability</ignoredUnusedDeclaredDependency>
									<!-- spring-boot-starter-* / logbook-spring-boot-starter: every
										 one is a POM-only aggregator (no classes of its own). Each
										 stays because it supplies autoconfiguration or Spring AOP
										 proxying infrastructure the direct dependencies above cannot
										 stand in for. -->
									<ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter-data-jpa</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter-validation</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter-aop</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter-web</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter-security</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter-oauth2-resource-server</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter-actuator</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>org.zalando:logbook-spring-boot-starter</ignoredUnusedDeclaredDependency>
									<!-- Classpath-driven / class-name-string-driven, never a direct
										 Java import: logstash-logback-encoder (referenced by class
										 name from logback config XML), springdoc (classpath-scanned
										 autoconfiguration), hibernate-jcache + ehcache (Hibernate's
										 hibernate.javax.cache.uri points at ehcache.xml by string,
										 not by import), micrometer-registry-prometheus (Actuator
										 autoconfigures PrometheusMeterRegistry from classpath
										 presence alone). -->
									<ignoredUnusedDeclaredDependency>net.logstash.logback:logstash-logback-encoder</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>org.springdoc:springdoc-openapi-starter-webmvc-ui</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>org.hibernate.orm:hibernate-jcache</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>org.ehcache:ehcache</ignoredUnusedDeclaredDependency>
									<ignoredUnusedDeclaredDependency>io.micrometer:micrometer-registry-prometheus</ignoredUnusedDeclaredDependency>
								</ignoredUnusedDeclaredDependencies>
								<!-- external-services: jackson-core is required at COMPILE scope —
									 verified empirically: scoping it to test breaks main compilation
									 (HeyGenClientImpl/YoutubeClientImpl fail with "cannot access
									 com.fasterxml.jackson.core.{Versioned,TreeNode,ObjectCodec,
									 JsonParser}"). javac needs these classes to resolve
									 ObjectMapper's own interface hierarchy even though main source
									 never names them directly, so the bytecode-reference analyzer
									 sees zero direct main-source reference and misclassifies it as
									 test-only. See backend/DEPENDENCY-ANALYSIS.md. -->
								<ignoredNonTestScopedDependencies>
									<ignoredNonTestScopedDependency>com.fasterxml.jackson.core:jackson-core</ignoredNonTestScopedDependency>
									<ignoredNonTestScopedDependency>${project.groupId}:domain</ignoredNonTestScopedDependency>
									<ignoredNonTestScopedDependency>${project.groupId}:cache-management</ignoredNonTestScopedDependency>
									<ignoredNonTestScopedDependency>jakarta.persistence:jakarta.persistence-api</ignoredNonTestScopedDependency>
									<ignoredNonTestScopedDependency>org.springframework.data:spring-data-jpa</ignoredNonTestScopedDependency>
								</ignoredNonTestScopedDependencies>
								<!-- application: external-services is used directly in Java
									 (YoutubeController/YoutubeApiMapper) but must NOT become a
									 direct pom.xml dependency — structure-lint asserts
									 "application/pom.xml must not depend on external-services —
									 route through service/". The edge already exists
									 transitively via service -> external-services, so this is
									 ignored rather than declared. See
									 backend/DEPENDENCY-ANALYSIS.md. -->
								<ignoredUsedUndeclaredDependencies>
									<ignoredUsedUndeclaredDependency>${project.groupId}:external-services</ignoredUsedUndeclaredDependency>
								</ignoredUsedUndeclaredDependencies>
							</configuration>
						</execution>
					</executions>
				</plugin>

				<plugin>
					<groupId>io.github.git-commit-id</groupId>
					<artifactId>git-commit-id-maven-plugin</artifactId>
					<version>9.0.1</version>
					<configuration>
						<skip>${git-commit-id.skip}</skip>
						<prefix>git-commit-id</prefix>
						<skipPoms>false</skipPoms>
						<failOnNoGitDirectory>false</failOnNoGitDirectory>
						<gitDescribe>
							<skip>true</skip>
						</gitDescribe>
						<offline>true</offline>
					</configuration>
					<executions>
						<execution>
							<id>git-commit-id</id>
							<goals>
								<goal>revision</goal>
							</goals>
							<phase>validate</phase>
						</execution>
					</executions>
				</plugin>

				<plugin>
					<groupId>org.openapitools</groupId>
					<artifactId>openapi-generator-maven-plugin</artifactId>
					<version>${openapi-generator.version}</version>
					<executions>
						<execution>
							<id>generate-openapi-server</id>
							<phase>generate-sources</phase>
							<goals>
								<goal>generate</goal>
							</goals>
							<configuration>
								<generatorName>spring</generatorName>
								<library>spring-boot</library>
								<!-- Spec OUTSIDE static/ (Vite emptyOutDir wipes static/);
									 public URL restored by OpenApiSpecConfig. -->
								<inputSpec>${project.basedir}/src/main/resources/api/v1/specs/openapi.yaml</inputSpec>
								<output>${project.build.directory}/generated-sources/openapi</output>
								<apiPackage>${project.groupId}.api.v1</apiPackage>
								<modelPackage>${project.groupId}.api.v1.model</modelPackage>
								<invokerPackage>${project.groupId}.api.v1.invoker</invokerPackage>
								<generateApiTests>false</generateApiTests>
								<generateModelTests>false</generateModelTests>
								<configOptions>
									<interfaceOnly>true</interfaceOnly>
									<useSpringBoot3>true</useSpringBoot3>
									<openApiNullable>false</openApiNullable>
									<skipDefaultInterface>true</skipDefaultInterface>
									<useTags>true</useTags>
									<dateLibrary>java8-localdatetime</dateLibrary>
									<additionalModelTypeAnnotations>@lombok.Generated</additionalModelTypeAnnotations>
								</configOptions>
							</configuration>
						</execution>
					</executions>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<argLine>@{argLine}
							-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
						</argLine>
						<includes>
							<include>**/*Test.java</include>
						</includes>
						<excludes>
							<exclude>**/*IT.java</exclude>
						</excludes>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<configuration>
						<argLine>@{argLine}
							-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
						</argLine>
						<includes>
							<include>**/*IT.java</include>
						</includes>
					</configuration>
				</plugin>

			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<!-- P9, 2026-08-11 (docs/aiae-migration-plan.md §6.1 D-C): the `handoff` profile
		 that used to live here duplicated exactly these two values and, per §2.3, was
		 already read by nothing — `.github/workflows/ci.yml` never passed -Phandoff
		 even before this phase (verified: P2 already replaced ci.yml with the
		 standard's coverage-phase.sh-driven workflow, which only ever passes -Pmvp or
		 nothing). The strict 0.80/0.70 default now lives once, in <properties>
		 above, and applies to every module unless that module's own pom overrides
		 it (see backend/domain/pom.xml). No -Pmvp profile is added here: D-C
		 deliberately relaxes per-module, pinned at measured values, not with a
		 global profile flip. -->

</project>
