<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.aidigital.aionboarding</groupId>
		<artifactId>app-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>domain</artifactId>
	<name>AIAE Onboarding Platform — domain</name>

	<!-- Coverage floor override — P9, 2026-08-11, docs/aiae-migration-plan.md §6.1 D-C.
		 The strict 0.80 LINE / 0.70 BRANCH default (backend/pom.xml properties) is
		 held everywhere it already passes. This module is the one exception,
		 measured 2026-08-11 with the seven hand-written jacoco excludes gone: 0.0232
		 LINE / 0.0714 BRANCH (entities and repositories, effectively untested).
		 Pinned just under that measured value so the module cannot regress further
		 while its tests are written — see docs/aiae-migration-plan.md §6.1 D-C
		 "Still open" and the P9 log row for the sizing. Remove this override only
		 once real tests (entity equals/hashCode contracts, Testcontainers
		 repository tests) close the gap to 0.80/0.70. -->
	<properties>
		<jacoco.line.coverage>0.0231</jacoco.line.coverage>
		<jacoco.branch.coverage>0.0714</jacoco.branch.coverage>
	</properties>

	<!-- Leaf module. Depends on JPA only. NO other internal modules.

		 spring-boot-starter-data-jpa is a POM-only aggregator: it carries no
		 classes of its own, so `maven-dependency-plugin:analyze-only` always
		 reports it "unused declared" once the JPA/Hibernate types this module
		 references directly (below) are declared explicitly. It stays declared
		 anyway — see backend/DEPENDENCY-ANALYSIS.md — because it supplies the
		 JPA/DataSource autoconfiguration this module's own Testcontainers
		 repository tests need (P15 step 3), which no directly-referenced class
		 can represent to the analyzer. spring-boot-starter-validation was
		 removed: zero jakarta.validation usage anywhere under domain/src. -->
	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Direct JPA/Hibernate types used by entities and repositories:
			 @Entity/@Id/@Column (jakarta.persistence-api), @Immutable/@Cache
			 (hibernate-core), JpaRepository (spring-data-jpa), Page/Sort/
			 Specification (spring-data-commons). -->
		<dependency>
			<groupId>jakarta.persistence</groupId>
			<artifactId>jakarta.persistence-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-commons</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Direct JUnit/AssertJ types used by IdAwareEntityTest and the
			 EqualsVerifier/repository tests added in P15 step 3. -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
