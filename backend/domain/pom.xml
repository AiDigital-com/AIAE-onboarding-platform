<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.aidigital.aionboarding</groupId>
		<artifactId>app-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>domain</artifactId>
	<name>AIAE Onboarding Platform — domain</name>

	<!-- Coverage floor override REMOVED — P15 step 3, 2026-08-14,
		 docs/aiae-migration-plan.md §6.1 D-C "Still open". The P9 override
		 (0.0231 LINE / 0.0714 BRANCH) pinned this module just above its
		 then-measured value while its equals/hashCode contract tests and
		 repository tests were still unwritten. Closed the gap: the ~10
		 composite-key *Id classes are covered via EqualsVerifier
		 (CompositeKeyEqualsContractTest) and the 4 *RepositoryImpl classes via
		 @DataJpaTest repository tests (H2/PostgreSQL mode — see the dependency
		 comment below for why not Testcontainers here). Measured 2026-08-14:
		 216/259 lines (83.4%), 108/112 branches (96.4%). This module now
		 inherits the strict 0.80/0.70 default from the parent POM like every
		 other module. -->

	<!-- Leaf module. Depends on JPA only. NO other internal modules.

		 spring-boot-starter-data-jpa is a POM-only aggregator: it carries no
		 classes of its own, so `maven-dependency-plugin:analyze-only` always
		 reports it "unused declared" once the JPA/Hibernate types this module
		 references directly (below) are declared explicitly. It stays declared
		 anyway — see backend/DEPENDENCY-ANALYSIS.md — because it supplies the
		 JPA/DataSource autoconfiguration this module's own repository tests
		 need (P15 step 3), which no directly-referenced class can represent to
		 the analyzer. spring-boot-starter-validation was removed: zero
		 jakarta.validation usage anywhere under domain/src.

		 P15 step 3's repository tests use @DataJpaTest against H2 in
		 PostgreSQL-compatibility mode (src/test/resources/application.yml),
		 not Testcontainers: this sandbox's Docker Desktop exposes a
		 non-standard named-pipe proxy that testcontainers-java's Npipe client
		 cannot negotiate with (`BadRequestException (Status 400: ...
		 "com.docker.desktop.address=npipe://\\.\pipe\docker_cli"`), regardless
		 of context/DOCKER_HOST override — verified against the already-present
		 CompletedRoadmapRepositoryIntegrationTest et al. in `application`,
		 which are silently *skipped* here for the identical reason
		 (`@Testcontainers(disabledWithoutDocker = true)`), not run. H2/PG-mode
		 is the same fallback `application-test.yml` already uses for
		 ApplicationSmokeTest. -->
	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Direct JPA/Hibernate types used by entities and repositories:
			 @Entity/@Id/@Column (jakarta.persistence-api), @Immutable/@Cache
			 (hibernate-core), JpaRepository (spring-data-jpa), Page/Sort/
			 Specification (spring-data-commons). -->
		<dependency>
			<groupId>jakarta.persistence</groupId>
			<artifactId>jakarta.persistence-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-commons</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Direct JUnit/AssertJ types used by IdAwareEntityTest and the
			 EqualsVerifier/repository tests added in P15 step 3. -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @DataJpaTest / @AutoConfigureTestDatabase for the repository tests. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-test-autoconfigure</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @SpringBootConfiguration / @EnableAutoConfiguration (DomainTestConfig)
			 and @Autowired (the repository tests) — test-only, since domain's own
			 main code has no Spring context to bootstrap. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-beans</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- In-memory database for the repository tests (H2, PostgreSQL mode). -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Runtime FormatMapper for @JdbcTypeCode(SqlTypes.JSON) columns
			 (Lesson.generationMetadata, Lesson.tags, ...): Hibernate needs
			 Jackson on the classpath to (de)serialize JSON columns even though
			 domain's own main code never calls Jackson directly. Test-only —
			 main code has no compile-time dependency on it. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Contract-based equals()/hashCode() verification for the ~10 composite
			 *Id key classes (P15 step 3). -->
		<dependency>
			<groupId>nl.jqno.equalsverifier</groupId>
			<artifactId>equalsverifier</artifactId>
			<version>3.17.3</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
